<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zafiro-avalonia-showme</ToolCommandName>
    <PackageId>Zafiro.Avalonia.ShowMe</PackageId>
    <Title>Zafiro.Avalonia.ShowMe</Title>
    <Description>CLI and GUI previewer for arbitrary Avalonia XAML using the host app context and official previewer.</Description>
    <Authors>SuperJMN</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SuperJMN/Zafiro.Avalonia.ShowMe</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SuperJMN/Zafiro.Avalonia.ShowMe.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia;xaml;previewer;design-time;tool;zafiro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RollForward>Major</RollForward>

    <!-- Platforms whose native assets ship with the tool. ShowMe needs the .NET SDK and a desktop to render,
         so the rest are left out. Each entry also keeps its more specific RIDs (osx keeps osx-x64 and osx-arm64). -->
    <SupportedNativeRuntimeIdentifiers>win-x64;win-arm64;osx;linux-x64;linux-arm64</SupportedNativeRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="RemoveUnsupportedRuntimesFromToolPackage" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_SupportedRuntimeIdentifierPattern>^($(SupportedNativeRuntimeIdentifiers.Replace(';', '|')))(-.+)?$</_SupportedRuntimeIdentifierPattern>
    </PropertyGroup>

    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RuntimeIdentifier)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RuntimeIdentifier)', '$(_SupportedRuntimeIdentifierPattern)'))" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveSymbolsFromToolPackage" BeforeTargets="PackTool">
    <ItemGroup>
      <_ToolPackageSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>

    <Delete Files="@(_ToolPackageSymbols)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Zafiro.Avalonia.ShowMe.Protocol\Zafiro.Avalonia.ShowMe.Protocol.csproj" />
    <ProjectReference Include="..\Zafiro.Avalonia.ShowMe.Host\Zafiro.Avalonia.ShowMe.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Remote.Protocol" Version="$(AvaloniaVersion)" />
    <PackageReference Include="PanAndZoom" Version="12.1.1" />
    <PackageReference Include="ReactiveUI" Version="23.2.28" />
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.6.0" />
    <PackageReference Include="Zafiro.Avalonia" Version="53.3.1" />
    <PackageReference Include="Zafiro.Avalonia.Mcp.AppHost" Version="0.1.10" />
  </ItemGroup>
</Project>
