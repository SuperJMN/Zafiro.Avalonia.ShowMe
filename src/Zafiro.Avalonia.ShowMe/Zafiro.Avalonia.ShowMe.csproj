<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zafiro-showme</ToolCommandName>
    <PackageId>Zafiro.Avalonia.ShowMe</PackageId>
    <Title>Zafiro.Avalonia.ShowMe</Title>
    <Description>CLI and GUI previewer for arbitrary Avalonia XAML using the host app context and official previewer.</Description>
    <Authors>SuperJMN</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Remote.Protocol" Version="$(AvaloniaVersion)" />
    <PackageReference Include="PanAndZoom" Version="12.1.1" />
    <PackageReference Include="ReactiveUI" Version="23.2.28" />
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.6.0" />
    <PackageReference Include="Zafiro.Avalonia.Mcp.AppHost" Version="0.1.10" />
  </ItemGroup>
</Project>
