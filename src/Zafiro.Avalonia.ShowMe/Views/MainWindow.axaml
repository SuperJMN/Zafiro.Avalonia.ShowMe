<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Zafiro.Avalonia.ShowMe.ViewModels"
        xmlns:views="using:Zafiro.Avalonia.ShowMe.Views"
        xmlns:paz="using:Avalonia.Controls.PanAndZoom"
        xmlns:panels="using:Zafiro.Avalonia.Controls.Panels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="Zafiro.Avalonia.ShowMe.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Zafiro ShowMe - Previsualizador XAML"
        Icon="/Assets/icon.png"
        Width="1050" Height="700"
        MinWidth="800" MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Estilos para los Thumbs de redimensionamiento -->
        <Style Selector="views|ResizeThumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Vertical Thumb (Derecha) -->
        <Style Selector="views|ResizeThumb.resize-thumb-v Border.grip-v">
            <Setter Property="Background" Value="{DynamicResource SystemChromeGrayColor}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <DoubleTransition Property="Width" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="views|ResizeThumb.resize-thumb-v:pointerover Border.grip-v">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Width" Value="6" />
        </Style>
        <Style Selector="views|ResizeThumb.resize-thumb-v:pressed Border.grip-v">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Width" Value="6" />
        </Style>

        <!-- Horizontal Thumb (Abajo) -->
        <Style Selector="views|ResizeThumb.resize-thumb-h Border.grip-h">
            <Setter Property="Background" Value="{DynamicResource SystemChromeGrayColor}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <DoubleTransition Property="Height" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="views|ResizeThumb.resize-thumb-h:pointerover Border.grip-h">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Height" Value="6" />
        </Style>
        <Style Selector="views|ResizeThumb.resize-thumb-h:pressed Border.grip-h">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Height" Value="6" />
        </Style>

        <!-- Corner Thumb (Esquina inferior derecha) -->
        <Style Selector="views|ResizeThumb.resize-thumb-c Border.grip-c">
            <Setter Property="Background" Value="{DynamicResource SystemChromeGrayColor}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="views|ResizeThumb.resize-thumb-c:pointerover Border.grip-c">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="views|ResizeThumb.resize-thumb-c:pressed Border.grip-c">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- Cursor de modo Inspector -->
        <Style Selector="Image#PreviewImage.inspector">
            <Setter Property="Cursor" Value="Cross" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- ================= BARRA DE HERRAMIENTAS / CABECERA ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <!-- Si no cabe en una fila, el panel de herramientas pasa a una segunda fila -->
            <panels:FlexPanel Wrap="Wrap" AlignItems="Center" ColumnGap="12" RowGap="6">

                <!-- Logo & Título -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                              Foreground="{DynamicResource SystemAccentColor}"
                              Width="18" Height="18" />
                    <TextBlock Text="ShowMe" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Botones Atrás y Abrir Archivo -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="toolbar"
                            Command="{Binding GoBackCommand}"
                            IsVisible="{Binding CanGoBack}"
                            ToolTip.Tip="{Binding BackToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                      Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="Atrás" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar"
                            Command="{Binding OpenFileCommand}"
                            ToolTip.Tip="Abrir archivo AXAML / XAML (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"
                                      Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir..." VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Indicador del archivo cargado -->
                    <Border IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Classes="toolbar-badge"
                            ToolTip.Tip="{Binding CurrentSession.Target.AxamlPath}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                      Width="12" Height="12" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentSession.Target.RelativeXamlPath}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       MaxWidth="130"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11.5" />
                            <TextBlock Text="{Binding CurrentSession.Target.TargetName, StringFormat='({0})'}"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       FontSize="10.5"
                                       MaxWidth="80"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Panel derecho unificado de herramientas -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            panels:FlexPanel.MarginLeftAuto="True"
                            IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <!-- Botón Catálogo de Recursos Toggle (Visible cuando el archivo tiene recursos o estilos) -->
                    <ToggleButton Classes="toolbar"
                                  IsVisible="{Binding CurrentSession.IsCatalogActive, FallbackValue=False}"
                                  IsChecked="{Binding CurrentSession.IsSidebarVisible, Mode=TwoWay}"
                                  ToolTip.Tip="Mostrar u ocultar el panel de recursos y estilos">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19M7,7H9V9H7V7M11,7H17V9H11V7M7,11H9V13H7V11M11,11H17V13H11V11M7,15H9V17H7V15M11,15H17V17H11V15Z"
                                      Width="12" Height="12" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                            <TextBlock Text="Recursos" FontSize="11.5" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="8" Padding="5,1">
                                <TextBlock Text="{Binding CurrentSession.CatalogItemCount}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Modo Inspector Toggle -->
                    <ToggleButton Classes="toolbar"
                                  IsVisible="{Binding CurrentSession.IsControlPreviewVisible, FallbackValue=True}"
                                  IsChecked="{Binding CurrentSession.IsInspectorActive, Mode=TwoWay}"
                                  ToolTip.Tip="Seleccionar un elemento para inspeccionarlo (Ctrl+Shift+C): pasa el puntero para resaltarlo y haz clic para seleccionarlo. Esc cancela. Clic derecho muestra la jerarquía de elementos bajo el puntero.">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="Inspeccionar" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    
                    <!-- Controles de Zoom -->
                    <Border Classes="toolbar-group"
                            IsVisible="{Binding CurrentSession.IsControlPreviewVisible, FallbackValue=True}">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="toolbar-group-btn icon"
                                     Command="{Binding CurrentSession.ZoomOutCommand}"
                                     AutomationProperties.Name="Alejar (Zoom Out)"
                                     ToolTip.Tip="Alejar (Zoom Out)">
                                <TextBlock Text="−" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            
                            <TextBlock Text="{Binding CurrentSession.ZoomText}"
                                       Width="40"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11" />

                            <Button Classes="toolbar-group-btn icon"
                                    Command="{Binding CurrentSession.ZoomInCommand}"
                                    AutomationProperties.Name="Acercar (Zoom In)"
                                    ToolTip.Tip="Acercar (Zoom In)">
                                <TextBlock Text="+" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>

                            <Button Classes="toolbar-group-btn"
                                    Command="{Binding CurrentSession.ResetZoomCommand}"
                                    AutomationProperties.Name="Zoom 100% (1:1)"
                                    ToolTip.Tip="Zoom 100% (1:1)">
                                <TextBlock Text="1:1" FontSize="11" VerticalAlignment="Center" />
                            </Button>

                            <Button Classes="toolbar-group-btn"
                                    Command="{Binding CurrentSession.FitCommand}"
                                    ToolTip.Tip="Ajustar al área visible">
                                <TextBlock Text="Ajustar" FontSize="11" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Control de Tamaño y Presets de resolución -->
                    <ComboBox Classes="toolbar"
                              IsVisible="{Binding CurrentSession.IsControlPreviewVisible, FallbackValue=True}"
                              ItemsSource="{Binding CurrentSession.Presets}"
                              SelectedItem="{Binding CurrentSession.SelectedPreset, Mode=TwoWay}"
                              PlaceholderText="Resolución..."
                              ToolTip.Tip="Elegir resolución predefinida"
                              Width="125">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DimensionPreset">
                                <TextBlock Text="{Binding DisplayText}" FontSize="11.5" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- SELECTOR DE THEME -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <PathIcon Data="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z"
                                  Width="13" Height="13" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                        <ComboBox Classes="toolbar"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  ToolTip.Tip="Cambiar tema (Aplicación / Claro / Oscuro)"
                                  Width="110">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeOption">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11.5" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Menú de acciones secundarias: Restablecer tamaño, Guardar, Copiar y Recargar -->
                    <Button Classes="toolbar icon"
                            AutomationProperties.Name="Más acciones"
                            ToolTip.Tip="Más acciones">
                        <PathIcon Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"
                                  Width="13" Height="13" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Restablecer tamaño original"
                                          IsVisible="{Binding CurrentSession.IsControlPreviewVisible, FallbackValue=True}"
                                          Command="{Binding CurrentSession.ResetDimensionsCommand}"
                                          ToolTip.Tip="Restablecer al tamaño original (d:DesignWidth / d:DesignHeight)">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M19,12H17.5C17.5,8.96 15.04,6.5 12,6.5C10.63,6.5 9.38,7 8.44,7.84L7,6.4C8.35,5.26 10.09,4.5 12,4.5C16.14,4.5 19.5,7.86 19.5,12H21L18.5,15.5L16,12H17.5C17.5,8.96 15.04,6.5 12,6.5M12,17.5C13.37,17.5 14.62,17 15.56,16.16L17,17.6C15.65,18.74 13.91,19.5 12,19.5C7.86,19.5 4.5,16.14 4.5,12H3L5.5,8.5L8,12H6.5C6.5,15.04 8.96,17.5 12,17.5Z"
                                                  Width="13" Height="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Guardar imagen..."
                                          Command="{Binding CurrentSession.SaveImageCommand}"
                                          IsEnabled="{Binding CurrentSession.CurrentBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          ToolTip.Tip="Guardar imagen renderizada como archivo PNG / JPEG">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                                  Width="13" Height="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copiar imagen"
                                          Command="{Binding CurrentSession.CopyImageCommand}"
                                          IsEnabled="{Binding CurrentSession.CurrentBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          ToolTip.Tip="Copiar imagen al portapapeles">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                                  Width="13" Height="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Recargar XAML"
                                          Command="{Binding CurrentSession.ReloadCommand}"
                                          ToolTip.Tip="Recargar XAML manualmente">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                  Width="13" Height="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Editor de código…"
                                          Command="{Binding ConfigureEditorCommand}"
                                          ToolTip.Tip="Elegir el editor externo de «Abrir en el editor»">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z"
                                                  Width="13" Height="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </panels:FlexPanel>
        </Border>

        <!-- ================= ÁREA CENTRAL DE PREVISUALIZACIÓN ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            
            <!-- PANEL LATERAL NATIVO: CATÁLOGO DE RECURSOS Y ESTILOS -->
            <Border Grid.Column="0"
                    Width="320"
                    IsVisible="{Binding CurrentSession.IsSidebarVisible, FallbackValue=False}"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="0,0,1,0"
                    ZIndex="10">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <!-- 1. Cabecera del Sidebar -->
                    <Border Grid.Row="0"
                            Padding="12,10,10,8"
                            BorderBrush="{DynamicResource SystemChromeHighColor}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19M7,7H9V9H7V7M11,7H17V9H11V7M7,11H9V13H7V11M11,11H17V13H11V11M7,15H9V17H7V15M11,15H17V17H11V15Z"
                                          Width="14" Height="14" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentSession.CatalogTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemAccentColorDark1}" CornerRadius="10" Padding="6,1.5">
                                <TextBlock Text="{Binding CurrentSession.CatalogItemCount}"
                                           FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <Button Grid.Column="2" Classes="toolbar icon"
                                    Command="{Binding CurrentSession.ToggleSidebarCommand}"
                                    Padding="4"
                                    AutomationProperties.Name="Ocultar panel lateral"
                                    ToolTip.Tip="Ocultar panel lateral">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. Caja de búsqueda -->
                    <Border Grid.Row="1" Padding="10,8,10,6">
                        <TextBox Text="{Binding CurrentSession.CatalogSearchText, Mode=TwoWay}"
                                 PlaceholderText="Buscar recursos o estilos..."
                                 FontSize="11.5"
                                 CornerRadius="4"
                                 Padding="8,5">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                          Width="11" Height="11" Margin="8,0,4,0" Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Border>

                    <!-- 3. Barra de Modos y Acciones -->
                    <Border Grid.Row="2" Padding="10,2,10,8" BorderBrush="{DynamicResource SystemChromeHighColor}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0" Classes="toolbar-group" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="toolbar-group-btn"
                                            Classes.active="{Binding CurrentSession.IsTreeMode}"
                                            Command="{Binding CurrentSession.SetTreeModeCommand}"
                                            AutomationProperties.Name="Vista jerárquica en árbol"
                                            ToolTip.Tip="Vista jerárquica en árbol">
                                        <TextBlock Text="⑂ Árbol" FontSize="11" />
                                    </Button>

                                    <Button Classes="toolbar-group-btn"
                                            Classes.active="{Binding CurrentSession.IsFlatMode}"
                                            Command="{Binding CurrentSession.SetFlatModeCommand}"
                                            AutomationProperties.Name="Lista plana de recursos"
                                            ToolTip.Tip="Lista plana de recursos">
                                        <TextBlock Text="≡ Lista" FontSize="11" />
                                    </Button>

                                    <Button Classes="toolbar-group-btn"
                                            IsVisible="{Binding CurrentSession.HasPreviewWith, FallbackValue=False}"
                                            Classes.active="{Binding CurrentSession.IsPreviewWithMode}"
                                            Command="{Binding CurrentSession.SelectPreviewWithCommand}"
                                            AutomationProperties.Name="Mostrar control Design.PreviewWith"
                                            ToolTip.Tip="Mostrar control Design.PreviewWith">
                                        <TextBlock Text="🖼 Vista previa" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="1" Classes="toolbar"
                                    Command="{Binding CurrentSession.SelectAllCardsCommand}"
                                    ToolTip.Tip="Mostrar todas las tarjetas en la cuadrícula">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="👁" FontSize="11" />
                                    <TextBlock Text="Ver todos" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 4. Contenido: TreeView o ListBox -->
                    <Panel Grid.Row="3">
                        <!-- Vista Árbol -->
                        <TreeView ItemsSource="{Binding CurrentSession.CatalogTreeNodes}"
                                  SelectedItem="{Binding CurrentSession.SelectedCatalogNode, Mode=TwoWay}"
                                  IsVisible="{Binding CurrentSession.IsTreeMode}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="vm:CatalogGroupNodeViewModel" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2">
                                        <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="11.5" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource SystemChromeHighColor}" CornerRadius="8" Padding="5,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding TotalItemCount}" FontSize="9" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        </Border>
                                    </StackPanel>
                                </TreeDataTemplate>

                                <DataTemplate DataType="vm:CatalogItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                IsVisible="{Binding ColorBrush, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Background="{Binding ColorBrush}"
                                                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" />
                                        <TextBlock Grid.Column="0" Text="{Binding KindIcon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   IsVisible="{Binding ColorBrush, Converter={x:Static ObjectConverters.IsNull}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KeyOrSelector}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="9.5" Foreground="{DynamicResource SystemBaseMediumColor}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{Binding KindBadgeBrush}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindText}" FontSize="8.5" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>

                        <!-- Vista Lista Plana -->
                        <ListBox ItemsSource="{Binding CurrentSession.FilteredFlatItems}"
                                 SelectedItem="{Binding CurrentSession.SelectedCatalogNode, Mode=TwoWay}"
                                 IsVisible="{Binding CurrentSession.IsFlatMode}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:CatalogItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                IsVisible="{Binding ColorBrush, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Background="{Binding ColorBrush}"
                                                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" />
                                        <TextBlock Grid.Column="0" Text="{Binding KindIcon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   IsVisible="{Binding ColorBrush, Converter={x:Static ObjectConverters.IsNull}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KeyOrSelector}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="9.5" Foreground="{DynamicResource SystemBaseMediumColor}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{Binding KindBadgeBrush}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindText}" FontSize="8.5" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Vista de PreviewWith activa -->
                        <StackPanel IsVisible="{Binding CurrentSession.IsPreviewWithMode}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="20">
                            <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="Vista previa oficial activa"
                                       FontWeight="SemiBold" FontSize="12" TextAlignment="Center" />
                            <TextBlock Text="Mostrando el control declarado en Design.PreviewWith."
                                       Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button Classes="toolbar" Command="{Binding CurrentSession.SetTreeModeCommand}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="Explorar recursos" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!-- PANEL CENTRAL DE PREVISUALIZACIÓN -->
            <Panel Grid.Column="1">
                <!-- FONDO CUADRICULADO NEUTRO (Tipo lienzo gráfico) -->
                <Panel Background="{DynamicResource SystemChromeLowColor}" />

            <!-- ESTADO VACÍO: ZONA DE DRAG & DROP -->
            <Border IsVisible="{Binding IsWelcomeVisible}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="drop-zone"
                    Padding="40,32"
                    MaxWidth="520">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <PathIcon Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04M14,13V17H10V13H7L12,8L17,13H14Z"
                              Width="48" Height="48"
                              Foreground="{DynamicResource SystemAccentColor}"
                              HorizontalAlignment="Center" />
                    
                    <TextBlock Text="Arrastra y suelta aquí un archivo .axaml"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    
                    <TextBlock Text="ShowMe analizará automáticamente el proyecto host, compilará y conectará con el previewer oficial de Avalonia."
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13" />

                    <Button HorizontalAlignment="Center"
                            Command="{Binding OpenFileCommand}"
                            Padding="16,8"
                            CornerRadius="6"
                            Background="{DynamicResource SystemAccentColor}"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"
                                      Width="16" Height="16" />
                            <TextBlock Text="Seleccionar archivo AXAML..." FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- VISTA DE CATÁLOGO / GALERÍA (Nativa en la shell, con scrollbar nativa) -->
            <ScrollViewer x:Name="CatalogScrollViewer"
                          IsVisible="{Binding CurrentSession.IsCatalogViewVisible, FallbackValue=False}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="#0B0F19">
                <Image x:Name="CatalogImage"
                       Source="{Binding CurrentSession.CurrentBitmap}"
                       Width="{Binding CurrentSession.PreviewWidth}"
                       Height="{Binding CurrentSession.PreviewHeight}"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top" />
            </ScrollViewer>

            <!-- CONTENEDOR PAN & ZOOM (Elemento central oficial) -->
            <paz:ZoomBorder x:Name="ZoomBorder"
                            IsVisible="{Binding CurrentSession.IsControlPreviewVisible, FallbackValue=False}"
                            PanButton="Right"
                            ZoomSpeed="1.2"
                            Stretch="None"
                            EnablePan="True"
                            EnableZoom="True"
                            EnableConstrains="False"
                            ClipToBounds="True"
                            Focusable="True"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch">
                
                <!-- Lienzo del fotograma renderizado con cabecera y thumbs de redimensionamiento -->
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    
                    <!-- Fila 0, Col 0: Barra superior de la ventana de previsualización -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Width="{Binding CurrentSession.PreviewWidth}"
                            Background="{DynamicResource SystemChromeLowColor}"
                            BorderBrush="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Padding="10,5"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M3,4H21A1,1 0 0,1 22,5V19A1,1 0 0,1 21,20H3A1,1 0 0,1 2,19V5A1,1 0 0,1 3,4M4,6V8H20V6H4M4,10V18H20V10H4Z"
                                          Width="12" Height="12"
                                          Foreground="{DynamicResource SystemBaseMediumColor}" />
                                <TextBlock Text="{Binding CurrentSession.Target.RelativeXamlPath}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource SystemChromeMediumColor}"
                                    CornerRadius="3"
                                    Padding="6,2">
                                <TextBlock Text="{Binding CurrentSession.DimensionsText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Fila 1, Col 0: Marco de la imagen renderizada -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Width="{Binding CurrentSession.PreviewWidth}"
                            Height="{Binding CurrentSession.PreviewHeight}"
                            BoxShadow="0 14 36 0 #35000000"
                            BorderBrush="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,6,6"
                            ClipToBounds="True"
                            Background="{DynamicResource SystemRegionBrush}">
                        
                        <Panel Width="{Binding CurrentSession.PreviewWidth}"
                               Height="{Binding CurrentSession.PreviewHeight}">
                            <Image x:Name="PreviewImage"
                                   Source="{Binding CurrentSession.CurrentBitmap}"
                                   Width="{Binding CurrentSession.PreviewWidth}"
                                   Height="{Binding CurrentSession.PreviewHeight}"
                                   Stretch="None"
                                   Focusable="True"
                                   Classes.inspector="{Binding CurrentSession.IsInspectorActive}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" />

                            <!-- Overlay Canvas para adorners de elementos (hover y selección) -->
                            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                <!-- Adorner Hover (Elemento bajo el puntero) -->
                                <Border IsVisible="{Binding CurrentSession.IsHoverAdornerVisible}"
                                        Canvas.Left="{Binding CurrentSession.HoveredElement.Bounds.X, FallbackValue=0}"
                                        Canvas.Top="{Binding CurrentSession.HoveredElement.Bounds.Y, FallbackValue=0}"
                                        Width="{Binding CurrentSession.HoveredElement.Bounds.Width, FallbackValue=0}"
                                        Height="{Binding CurrentSession.HoveredElement.Bounds.Height, FallbackValue=0}"
                                        BorderBrush="#4CC2FF"
                                        BorderThickness="1.5"
                                        Background="#1800B4D8"
                                        CornerRadius="2">
                                    <Border Background="#0096C7"
                                            CornerRadius="0,0,4,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="5,1.5"
                                            BoxShadow="0 2 6 0 #33000000">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding CurrentSession.HoveredElement.TypeName}"
                                                       Foreground="White"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentSession.HoveredElement.ElementName, StringFormat='#{0}'}"
                                                       Foreground="#B3E5FC"
                                                       FontSize="9"
                                                       IsVisible="{Binding CurrentSession.HoveredElement.ElementName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding CurrentSession.HoveredElement.DimensionsText}"
                                                       Foreground="#E0F7FA"
                                                       FontSize="9"
                                                       Opacity="0.85" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <!-- Adorner Selección (Elemento seleccionado con clic) -->
                                <Border IsVisible="{Binding CurrentSession.SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Canvas.Left="{Binding CurrentSession.SelectedElement.Bounds.X, FallbackValue=0}"
                                        Canvas.Top="{Binding CurrentSession.SelectedElement.Bounds.Y, FallbackValue=0}"
                                        Width="{Binding CurrentSession.SelectedElement.Bounds.Width, FallbackValue=0}"
                                        Height="{Binding CurrentSession.SelectedElement.Bounds.Height, FallbackValue=0}"
                                        BorderBrush="{DynamicResource SystemAccentColor}"
                                        BorderThickness="2"
                                        Background="#260078D4"
                                        CornerRadius="2">
                                    <Border Background="{DynamicResource SystemAccentColor}"
                                            CornerRadius="0,0,4,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="5,1.5"
                                            BoxShadow="0 2 6 0 #40000000">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding CurrentSession.SelectedElement.TypeName}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="{Binding CurrentSession.SelectedElement.ElementName, StringFormat='#{0}'}"
                                                       Foreground="#BBDEFB"
                                                       FontSize="9.5"
                                                       IsVisible="{Binding CurrentSession.SelectedElement.ElementName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding CurrentSession.SelectedElement.DimensionsText}"
                                                       Foreground="#E3F2FD"
                                                       FontSize="9.5"
                                                       Opacity="0.85" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Canvas>
                        </Panel>
                    </Border>

                    <!-- Fila 1, Col 1: Thumb Vertical (Derecha - Redimensionar Ancho) -->
                    <views:ResizeThumb x:Name="RightThumb"
                                       Grid.Row="1" Grid.Column="1"
                                       Direction="Horizontal"
                                       Session="{Binding CurrentSession}"
                                       Classes="resize-thumb-v"
                                       Cursor="SizeWestEast"
                                       Width="12"
                                       VerticalAlignment="Stretch"
                                       ToolTip.Tip="Arrastrar para cambiar ancho (Width)"
                                       Margin="2,0,0,0">
                        <Border Classes="grip-v"
                                Width="4" Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </views:ResizeThumb>

                    <!-- Fila 2, Col 0: Thumb Horizontal (Abajo - Redimensionar Alto) -->
                    <views:ResizeThumb x:Name="BottomThumb"
                                       Grid.Row="2" Grid.Column="0"
                                       Direction="Vertical"
                                       Session="{Binding CurrentSession}"
                                       Classes="resize-thumb-h"
                                       Cursor="SizeNorthSouth"
                                       Height="12"
                                       HorizontalAlignment="Stretch"
                                       ToolTip.Tip="Arrastrar para cambiar alto (Height)"
                                       Margin="0,2,0,0">
                        <Border Classes="grip-h"
                                Height="4" Width="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </views:ResizeThumb>

                    <!-- Fila 2, Col 1: Thumb Esquina (Inferior Derecha - Redimensionar Ambos) -->
                    <views:ResizeThumb x:Name="CornerThumb"
                                       Grid.Row="2" Grid.Column="1"
                                       Direction="Both"
                                       Session="{Binding CurrentSession}"
                                       Classes="resize-thumb-c"
                                       Cursor="BottomRightCorner"
                                       Width="14" Height="14"
                                       Margin="2,2,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       ToolTip.Tip="Arrastrar para cambiar ancho y alto">
                        <Border Classes="grip-c"
                                Width="8" Height="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </views:ResizeThumb>
                </Grid>
            </paz:ZoomBorder>

            <!-- OVERLAY DE CARGA -->
            <Border IsVisible="{Binding IsLoading}"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    CornerRadius="8"
                    Padding="24,18"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #40000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Text="{Binding LoadingDetail}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding LoadingDetail}" />
                </StackPanel>
            </Border>

            <!-- BANNER DE ERROR (XAML / Build) -->
            <Border IsVisible="{Binding HasError}"
                    Background="#E6D32F2F"
                    CornerRadius="6"
                    Margin="16"
                    Padding="16,12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    BoxShadow="0 4 16 0 #30000000">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0"
                              Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                              Foreground="White" Width="20" Height="20" Margin="0,0,12,0" />
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               Foreground="White"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Command="{Binding DismissErrorCommand}"
                            Background="Transparent"
                            Foreground="White"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Cerrar mensaje de error"
                            ToolTip.Tip="Cerrar mensaje de error">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>

            <!-- ERROR ESPECÍFICO DE XAML -->
            <Border IsVisible="{Binding CurrentSession.HasXamlError, FallbackValue=False}"
                    Background="#E6D32F2F"
                    CornerRadius="6"
                    Margin="16"
                    Padding="16,12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    BoxShadow="0 4 16 0 #30000000">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                  Foreground="White" Width="16" Height="16" />
                        <TextBlock Text="Error en sintaxis o ejecución de XAML:"
                                   FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentSession.XamlError}"
                               Foreground="White" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock Text="{Binding CurrentSession.XamlErrorDetails}"
                               Foreground="#FFDDDD" FontSize="11"
                               IsVisible="{Binding CurrentSession.XamlErrorDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </Panel>

            <!-- VISOR DE XAML (solo lectura): ocupa su propia columna para no tapar la vista previa -->
            <Border Grid.Column="2"
                    Width="480"
                    IsVisible="{Binding CurrentSession.SourceView, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemChromeHighColor}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="10,6"
                            BorderBrush="{DynamicResource SystemChromeHighColor}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                            <PathIcon Grid.Column="0"
                                      Data="M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z"
                                      Width="13" Height="13" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SystemAccentColor}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentSession.SourceView.LocationText, FallbackValue=''}"
                                       ToolTip.Tip="{Binding CurrentSession.SourceView.FilePath, FallbackValue=''}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="toolbar"
                                    Command="{Binding CurrentSession.OpenInEditorCommand}"
                                    IsVisible="{Binding CurrentSession.CanOpenInEditor, FallbackValue=False}"
                                    ToolTip.Tip="{Binding CurrentSession.SelectedElement.EditorToolTip, FallbackValue='Abrir en el editor de código'}">
                                <TextBlock Text="Abrir en el editor" FontSize="11.5" VerticalAlignment="Center" />
                            </Button>
                            <Button Grid.Column="3" Classes="toolbar icon"
                                    Command="{Binding CurrentSession.CloseSourceViewCommand}"
                                    AutomationProperties.Name="Cerrar visor de XAML"
                                    ToolTip.Tip="Cerrar visor de XAML (Esc)">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </Button>
                        </Grid>
                    </Border>
                    <views:XamlSourceView x:Name="SourceViewer"
                                          Source="{Binding CurrentSession.SourceView, FallbackValue={x:Null}}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= BARRA DE ESTADO ================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNotNull}}">
                
                <!-- Estado izquierdo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding CurrentSession.IsHotReloadActive, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=#2ECC71}" />
                    <TextBlock Text="{Binding CurrentSession.Status, FallbackValue='Listo'}"
                               ToolTip.Tip="{Binding CurrentSession.Status, FallbackValue='Listo'}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               FontSize="12"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Archivo y proyecto central (cuando no hay elemento seleccionado) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentSession.Target.HostProjectPath}"
                           Foreground="{DynamicResource SystemBaseLowColor}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           IsVisible="{Binding CurrentSession.SelectedElement, Converter={x:Static ObjectConverters.IsNull}}" />

                <!-- Información del elemento seleccionado -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding CurrentSession.SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="3" Padding="6,2">
                        <TextBlock Text="{Binding CurrentSession.SelectedElement.DisplayTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   FontSize="11" />
                    </Border>
                    <Border Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="3" Padding="6,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Tamaño:" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11" />
                            <TextBlock Text="{Binding CurrentSession.SelectedElement.Bounds.Width, StringFormat='{}{0:0.#}'}" FontSize="11" FontWeight="Medium" />
                            <TextBlock Text="×" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                            <TextBlock Text="{Binding CurrentSession.SelectedElement.Bounds.Height, StringFormat='{}{0:0.#} px'}" FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="3" Padding="6,2"
                            IsVisible="{Binding CurrentSession.SelectedElement.LocationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                        <TextBlock Text="{Binding CurrentSession.SelectedElement.LocationText}"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                    <Button Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="3" Padding="6,2" MinHeight="0"
                            Command="{Binding CurrentSession.ViewXamlCommand}"
                            ToolTip.Tip="{Binding CurrentSession.SelectedElement.ViewXamlToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z" Width="11" Height="11" VerticalAlignment="Center" />
                            <TextBlock Text="Ver XAML" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="3" Padding="6,2" MinHeight="0"
                            Command="{Binding CurrentSession.OpenDefiningViewCommand}"
                            IsVisible="{Binding CurrentSession.CanOpenDefiningView, FallbackValue=False}"
                            ToolTip.Tip="{Binding CurrentSession.SelectedElement.OpenViewToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Width="11" Height="11" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir vista" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="3" Padding="6,2" MinHeight="0"
                            Command="{Binding CurrentSession.OpenInEditorCommand}"
                            IsVisible="{Binding CurrentSession.CanOpenInEditor, FallbackValue=False}"
                            ToolTip.Tip="{Binding CurrentSession.SelectedElement.EditorToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" Width="11" Height="11" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir en el editor" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Información derecha: Resolución y Zoom -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentSession.DimensionsText}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    
                    <TextBlock Text="{Binding CurrentSession.ZoomText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemAccentColor}"
                               IsVisible="{Binding CurrentSession.IsControlPreviewVisible, FallbackValue=False}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= DIÁLOGO: EDITOR DE CÓDIGO ================= -->
        <Panel Grid.Row="0" Grid.RowSpan="3"
               IsVisible="{Binding EditorSettings, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="#66000000">
            <Border Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    CornerRadius="8"
                    Padding="20,18"
                    BoxShadow="0 8 24 0 #40000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="Editor de código" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Comando que abre un elemento en tu editor con «Abrir en el editor». Ver el XAML siempre ocurre dentro de ShowMe."
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="EditorCommandBox"
                             Text="{Binding EditorSettings.Command, FallbackValue=''}"
                             PlaceholderText="rider --line {line} --column {column} {file}"
                             FontFamily="Cascadia Code,JetBrains Mono,Consolas,DejaVu Sans Mono,monospace"
                             FontSize="12" />
                    <TextBlock Text="{}{file}, {line} y {column} se sustituyen por el archivo, la línea y la columna. Déjalo vacío para usar $VISUAL o $EDITOR."
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EditorSettings.CurrentEditorText, FallbackValue=''}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Esta sesión se abrió con --editor, que prevalece sobre el editor guardado."
                               IsVisible="{Binding EditorSettings.IsOverriddenByCommandLine, FallbackValue=False}"
                               Foreground="{DynamicResource SystemAccentColor}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EditorSettings.Error, FallbackValue=''}"
                               IsVisible="{Binding EditorSettings.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                               Foreground="#E53935"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="toolbar" Command="{Binding EditorSettings.CancelCommand}" Content="Cancelar" />
                        <Button Classes="toolbar accent" Command="{Binding EditorSettings.SaveCommand}" Content="Guardar" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Grid>
</Window>
